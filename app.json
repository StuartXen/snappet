{
  "expo": {
    "name": "Snappet",
    "slug": "snappet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "snappet",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.snappet.ios",
      "supportsTablet": true,
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "Snappet uses the camera to capture a still photo of your pet so it can read published facial-expression signals.",
        "NSPhotoLibraryUsageDescription": "Snappet reads a photo you choose so it can map facial cues to grimace-scale features."
      }
    },
    "android": {
      "package": "app.snappet.android",
      "adaptiveIcon": {
        "backgroundColor": "#F7F0E6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F0E6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Snappet uses the camera to capture a still photo of your pet so it can read published facial-expression signals.",
          "microphonePermission": "Snappet does not record audio. Microphone access is unused.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Snappet reads a photo you choose so it can map facial cues to grimace-scale features."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
